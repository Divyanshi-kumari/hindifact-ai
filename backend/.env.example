# Folder containing the unzipped artifacts_bundle.zip (muril/, corpus.csv, corpus_emb.npy)
ARTIFACTS_DIR=./artifacts
MURIL_DIR=./artifacts/muril
# Must be the SAME model that built corpus_emb.npy in your notebook
SBERT_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
MAX_LENGTH=256
# Bias added to logits [False, Mostly False, Partly True] - the value tuned on validation in your notebook
LOGIT_BIAS=0,0.75,0
# Minimum cosine similarity for a Sentence-BERT passage to count as retrieved
MIN_SIM=0.25
CORS_ORIGINS=http://localhost:5173
